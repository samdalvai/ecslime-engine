{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "ecslime-engine": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "apps/**/*",
    "__tests__/**/*",
    "benchmark/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
